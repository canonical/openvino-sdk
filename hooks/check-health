# Verify native library is present
if ! ldconfig -p | grep libopenvino >/dev/null; then
	workshopctl set-health --code="openvino-lib-missing" error "libopenvino not found"
	exit 0
fi

# Verify OpenVINO and its Python dependencies are importable from the venv --
# the environment used by workshop shells and the jupyter SDK.
venv_python="$SDK/venv/bin/python"
if ! "$venv_python" -c "import openvino; import openvino_genai"; then
	workshopctl set-health --code="openvino-python-missing" error "OpenVINO not importable from the venv at $SDK/venv"
	exit 0
fi

workshopctl set-health okay
