add-apt-repository ppa:kobuk-team/intel-graphics
apt-get update
apt-get install ocl-icd-libopencl1 \
  libtbb12 \
  libsnappy1v5 \
  libgl1 \
  libigc-tools \
  libigc2 \
  libigdfcl2 \
  intel-ocloc \
  intel-opencl-icd \
  libze1 \
  libze-intel-gpu1 \
  libigdgmm12 \
  ocl-icd-libopencl1 \
  libtbb12 \
  libsnappy1v5

echo "$SDK/usr/lib/x86_64-linux-gnu" | tee /etc/ld.so.conf.d/openvino-toolkit.conf
ldconfig

install -D -m 644 --target-directory=/usr/lib/x86_64-linux-gnu/pkgconfig "$SDK/usr/lib/x86_64-linux-gnu/pkgconfig/openvino.pc"

# Register OpenVINO with the system Python so it is importable without a venv
echo "$SDK/usr/lib/python3/dist-packages" | tee /usr/lib/python3/dist-packages/openvino.pth

# Activate the OpenVINO venv for interactive (login) shells such as `workshop
# shell`, so python and pip resolve to the venv where OpenVINO's Python
# dependencies are installed.
cat > /etc/profile.d/openvino-venv.sh <<EOF
if [ -f "$SDK/venv/bin/activate" ]; then
    . "$SDK/venv/bin/activate"
fi
EOF
